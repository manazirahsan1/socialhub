@implements IDisposable
@inject RealtimeService Realtime
@inject ApiClient Api
@inject NavigationManager Nav

<header class="topbar">
    <div class="container-xxl d-flex align-items-center gap-3">
        <a class="brand" href="">socialhub</a>

        <form class="search flex-grow-1" @onsubmit="Search" @onsubmit:preventDefault>
            <i class="bi bi-search"></i>
            <input class="form-control" placeholder="Search SocialHub" @bind="query" aria-label="Search people" />
        </form>

        <nav class="d-flex align-items-center gap-1">
            <NavLink class="icon-btn" href="" Match="NavLinkMatch.All" title="Home"><i class="bi bi-house-door-fill"></i></NavLink>
            <NavLink class="icon-btn" href="friends" title="Friends"><i class="bi bi-people-fill"></i></NavLink>
            <NavLink class="icon-btn" href="messages" title="Messages">
                <i class="bi bi-chat-dots-fill"></i>
                @if (Realtime.UnreadMessages > 0) { <span class="badge-dot">@Realtime.UnreadMessages</span> }
            </NavLink>
            <NavLink class="icon-btn" href="notifications" title="Notifications">
                <i class="bi bi-bell-fill"></i>
                @if (Realtime.UnreadNotifications > 0) { <span class="badge-dot">@Badge(Realtime.UnreadNotifications)</span> }
            </NavLink>

            <AuthorizeView Context="auth">
                <div class="dropdown ms-1">
                    <button class="btn p-0 border-0" @onclick="() => menuOpen = !menuOpen" aria-label="Account menu">
                        <Avatar User="auth.User.ToSummary()" Size="40" />
                    </button>
                    @if (menuOpen)
                    {
                        <div class="dropdown-menu dropdown-menu-end show account-menu" @onclick="() => menuOpen = false">
                            <a class="dropdown-item" href="profile/@auth.User.UserId()"><i class="bi bi-person me-2"></i>My profile</a>
                            <a class="dropdown-item" href="settings"><i class="bi bi-gear me-2"></i>Settings</a>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item" @onclick="Logout"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                        </div>
                    }
                </div>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private string query = "";
    private bool menuOpen;

    protected override void OnInitialized() => Realtime.CountsChanged += OnCountsChanged;

    private void OnCountsChanged() => InvokeAsync(StateHasChanged);

    private static string Badge(int n) => n > 9 ? "9+" : n.ToString();

    private void Search()
    {
        if (!string.IsNullOrWhiteSpace(query))
            Nav.NavigateTo($"search?q={Uri.EscapeDataString(query.Trim())}");
    }

    private async Task Logout()
    {
        await Realtime.StopAsync();
        await Api.LogoutAsync();
        Nav.NavigateTo("login", replace: true);
    }

    public void Dispose() => Realtime.CountsChanged -= OnCountsChanged;
}
